<?xml version="1.0"?>

<configurator>
  <domain name="CHIP"/>
  <enum name="MqttTransport" type="enum8">
    <cluster code="0x15E7FC00"/>
    <item value="0x0000" name="SSL"/>
    <item value="0x0001" name="WSS"/>
  </enum>
  <!-- PublishQosBitmap: the MQTT QoS of each kind of message the device publishes.
       Bit n = 1: kind n is published at QoS 1; 0: QoS 0. This is a contract with the server:
       - A bit's position is permanent. Never reorder or reuse one; a removed kind's bit stays
         reserved, and a new kind takes the next free bit.
       - ReadResponse (bit 4) and ErrorReply (bit 12) can never be QoS 1. The device rejects a
         write that sets either.
       - Bits 20-31 are reserved and must be 0. The device rejects a write that sets one.
       - LastWill (bit 14) takes effect at the next connect; every other bit applies from the
         next message of its kind.
       - Default 0x0007E00F: FullReport, AttributeReport, EventReport, TelemetryBlob, Presence,
         LastWill, InsightsBoot, InsightsReport, OtaFetch and OtaStatus at QoS 1. -->
  <bitmap name="PublishQosBitmap" type="bitmap32">
    <cluster code="0x15E7FC00"/>
    <field name="FullReport"             mask="0x00000001"/> <!-- bit  0: state/report -->
    <field name="AttributeReport"        mask="0x00000002"/> <!-- bit  1: state/report -->
    <field name="EventReport"            mask="0x00000004"/> <!-- bit  2: state/report -->
    <field name="TelemetryBlob"          mask="0x00000008"/> <!-- bit  3: state/report photon/telemetry1.0 -->
    <field name="ReadResponse"           mask="0x00000010"/> <!-- bit  4: res/read -->
    <field name="WriteResponse"          mask="0x00000020"/> <!-- bit  5: res/write -->
    <field name="CommandResponse"        mask="0x00000040"/> <!-- bit  6: res/cmd -->
    <field name="AutomationResponse"     mask="0x00000080"/> <!-- bit  7: res/automation -->
    <field name="TelemetryReadResponse"  mask="0x00000100"/> <!-- bit  8: res/read photon/telemetry1.0 -->
    <field name="TelemetryWriteResponse" mask="0x00000200"/> <!-- bit  9: res/write photon/telemetry1.0 -->
    <field name="TimeReadResponse"       mask="0x00000400"/> <!-- bit 10: res/read photon/time1.0 -->
    <field name="TimeWriteResponse"      mask="0x00000800"/> <!-- bit 11: res/write photon/time1.0 -->
    <field name="ErrorReply"             mask="0x00001000"/> <!-- bit 12: any res/*, from mqtt_task -->
    <field name="Presence"               mask="0x00002000"/> <!-- bit 13: presence -->
    <field name="LastWill"               mask="0x00004000"/> <!-- bit 14: presence, sent by the broker -->
    <field name="InsightsBoot"           mask="0x00008000"/> <!-- bit 15: diagnostics/boot -->
    <field name="InsightsReport"         mask="0x00010000"/> <!-- bit 16: diagnostics/report -->
    <field name="OtaFetch"               mask="0x00020000"/> <!-- bit 17: ota/fetch -->
    <field name="OtaStatus"              mask="0x00040000"/> <!-- bit 18: ota/status -->
    <field name="OtaProgress"            mask="0x00080000"/> <!-- bit 19: ota/progress -->
  </bitmap>
  <struct name="PhotonMQTTStruct">
    <cluster code="0x15E7FC00"/>
    <item fieldId="1" name="Host" type="char_string" length="254"/>
    <item fieldId="2" name="Port" type="int16u"/>
    <item fieldId="3" name="Transport" type="MqttTransport" default="0"/>
    <item fieldId="4" name="KeepAlive" type="int16u" default="120"/>
    <item fieldId="5" name="CleanSession" type="boolean" default="1"/>
    <item fieldId="6" name="ReconnectBackoffBaseMS" type="int32u" default="30000"/>
    <item fieldId="7" name="TimeoutMS" type="int32u" default="10000"/>
    <!-- fieldId 8 (RefreshConnectionAfterMS) was removed: reserved, never reuse it. -->
    <item fieldId="9" name="SessionExpiryIntervalS" type="int32u" default="0"/>
    <item fieldId="10" name="MaxPacketSize" type="int32u" default="0"/>
    <item fieldId="11" name="MaxReceivePacketCount" type="int16u" default="0"/>
    <item fieldId="12" name="MaxTopicAlias" type="int16u" default="0"/>
    <item fieldId="13" name="RequestRespInfo" type="boolean" default="0"/>
    <item fieldId="14" name="RequestProblemInfo" type="boolean" default="0"/>
    <item fieldId="15" name="WillDelayIntervalS" type="int32u" default="0"/>
    <item fieldId="16" name="MessageExpiryIntervalS" type="int32u" default="0"/>
    <item fieldId="17" name="PayloadFormatIndicator" type="boolean" default="0"/>
    <item fieldId="18" name="ReconnectBackoffMaxMS" type="int32u" default="900000"/>
    <item fieldId="19" name="BootJitterMaxMS" type="int32u" default="45000"/>
    <!-- Optional, unlike fields 1-19: 0 is a valid PublishQos (everything at QoS 0), so an
         absent field must mean "keep the current value", not 0. -->
    <item fieldId="20" name="PublishQos" type="PublishQosBitmap" default="0x0007E00F" optional="true"/>
  </struct>
  <struct name="PhotonInsightsParamsStruct">
  <cluster code="0x15E7FC00"/>
    <item fieldId="0" name="coreDumpEnabled" type="boolean" default="1"/>
    <item fieldId="1" name="minInterval" type="elapsed_s" default="60" min="60"/>
    <item fieldId="2" name="maxInterval" type="elapsed_s" default="240" min="240"/>
    <item fieldId="3" name="dropWifiLogs" type="boolean" default="1"/>
    <item fieldId="4" name="reportMetrics" type="boolean" default="1"/>
    <item fieldId="5" name="reportHeapMetrics" type="boolean" default="1"/>
    <item fieldId="6" name="HeapPollingInterval" type="elapsed_s" default="28800" min="30" max="86400"/>
    <item fieldId="7" name="HeapPollingCount" type="int8u" default="5" min="1" max="100"/>
    <item fieldId="8" name="reportWifiMetrics" type="boolean" default="1"/>
    <item fieldId="9" name="WifiPollingInterval" type="elapsed_s" default="28800" min="30" max="86400"/>
    <item fieldId="10" name="WifiPollingCount" type="int8u" default="5" min="1" max="100"/>
    <item fieldId="11" name="usePolling" type="boolean" default="1"/>
    <item fieldId="12" name="reportVariables" type="boolean" default="1"/>
    <item fieldId="13" name="reportNetworkVariables" type="boolean" default="1"/>
    <item fieldId="14" name="reportMoreNetworkVariables" type="boolean" default="0"/>
    <item fieldId="15" name="reportWatermarkPercent" type="percent" default="80" min="50" max="90"/>

  </struct>


  <cluster>
    <name>Photon Smart</name>\
    <domain>PHOTON</domain>
    <description>Attributes and commands for Photon Smart Products.</description>
    <code>0x15E7FC00</code>
    <define>PHOTON_SMART_CLUSTER</define>

    <globalAttribute code="0xFFFD" side="either" value="1"/>

    <attribute side="server" code="0x0000" name="DeviceId" define="DEVICE_ID" type="char_string" length="36">
      <description>DeviceId</description>
      <access op="read" privilege="administer"/>
      <mandatoryConform/>
    </attribute>

    <attribute side="server" code="0x0001" name="ShouldReboot" define="SHOULD_REBOOT" type="boolean" default="0">
      <description>ShouldReboot</description>
      <mandatoryConform/>
    </attribute>

    <attribute side="server" code="0x0002" name="MqttConfig" define="MQTT_CONFIG" type="PhotonMQTTStruct" writable="true">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>MqttConfig</description>
    </attribute>

    <attribute side="server" code="0x0003" name="MqttReportEnabled" define="MQTT_REPORT_ENABLED" type="boolean" writable="true" default="1">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>MqttReportEnabled</description>
    </attribute>

    <attribute side="server" code="0x0004" name="InsightsEnabled" define="INSIGHTS_ENABLED" type="boolean" writable="true" default="1">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>InsightsEnabled</description>
    </attribute>

    <attribute side="server" code="0x0005" name="InsightsParams" define="INSIGHTS_PARAMS" type="PhotonInsightsParamsStruct" writable="true">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>InsightsParams</description>
    </attribute>

    <attribute side="server" code="0x0006" name="PublicIpv4Address" define="PUBLIC_IPV4_ADDRESS" type="int32u" default="0">
      <access op="read" privilege="administer"/>
      <mandatoryConform/>
      <description>PublicIpv4Address</description>
    </attribute>

    <attribute side="server" code="0x0007" name="PublicIpv4Enabled" define="PUBLIC_IPV4_ENABLED" type="boolean" default="1" writable="true">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>PublicIpv4Enabled</description>
    </attribute> 


    <command source="client" code="0x00" name="Reboot" optional="true">
      <description>This command is used to reboot the device.</description>
      <arg id="0" name="RebootAfter" type="int16u" default="0" min="0" max="65535"/>
      <access op="invoke" privilege="administer"/>
      <mandatoryConform/>
    </command>

    <command source="client" code="0x01" name="FactoryReset" optional="true">
      <description>This command is used to initiate factory reset the device.</description>
      <arg id="0" name="ResetAfter" type="int16u" default="0" min="0" max="65535"/>
      <access op="invoke" privilege="administer"/>
      <mandatoryConform/>
    </command>

  </cluster>
</configurator>
