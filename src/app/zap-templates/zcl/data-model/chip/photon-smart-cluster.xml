<?xml version="1.0"?>

<configurator>
  <domain name="CHIP"/>
  <enum name="MqttTransport" type="enum8">
    <cluster code="0x15E7FC00"/>
    <item value="0x0000" name="SSL"/>
    <item value="0x0001" name="WSS"/>
  </enum>
  <struct name="PhotonMQTTStruct">
    <cluster code="0x15E7FC00"/>
    <item fieldId="1" name="Host" type="char_string" length="254"/>
    <item fieldId="2" name="Port" type="int16u"/>
    <item fieldId="3" name="Transport" type="MqttTransport" default="0"/>
    <item fieldId="4" name="KeepAlive" type="int16u"/>
    <item fieldId="5" name="CleanSession" type="boolean" default="1"/>
    <item fieldId="6" name="ReconnectTimeoutMS" type="int32u" default="10000"/>
    <item fieldId="7" name="TimeoutMS" type="int32u" default="10000"/>
    <item fieldId="8" name="RefreshConnectionAfterMS" type="int32u" default="0"/>
  </struct>
  <struct name="PhotonInsightsParamsStruct">
  <cluster code="0x15E7FC00"/>
    <item fieldId="0" name="coreDumpEnabled" type="boolean" default="1"/>
    <item fieldId="1" name="minInterval" type="elapsed_s" default="60" min="60"/>
    <item fieldId="2" name="maxInterval" type="elapsed_s" default="240" min="240"/>
    <item fieldId="3" name="dropWifiLogs" type="boolean" default="1"/>
    <item fieldId="4" name="reportMetrics" type="boolean" default="1"/>
    <item fieldId="5" name="reportHeapMetrics" type="boolean" default="1"/>
    <item fieldId="6" name="HeapPollingInterval" type="elapsed_s" default="28800" min="30" max="86400"/>
    <item fieldId="7" name="HeapPollingCount" type="int8u" default="5" min="1" max="100"/>
    <item fieldId="8" name="reportWifiMetrics" type="boolean" default="1"/>
    <item fieldId="9" name="WifiPollingInterval" type="elapsed_s" default="28800" min="30" max="86400"/>
    <item fieldId="10" name="WifiPollingCount" type="int8u" default="5" min="1" max="100"/>
    <item fieldId="11" name="usePolling" type="boolean" default="1"/>
    <item fieldId="12" name="reportVariables" type="boolean" default="1"/>
    <item fieldId="13" name="reportNetworkVariables" type="boolean" default="1"/>
    <item fieldId="14" name="reportMoreNetworkVariables" type="boolean" default="0"/>
    <item fieldId="15" name="reportWatermarkPercent" type="percent" default="80" min="50" max="90"/>

  </struct>


  <cluster>
    <name>Photon Smart</name>\
    <domain>PHOTON</domain>
    <description>Attributes and commands for Photon Smart Products.</description>
    <code>0x15E7FC00</code>
    <define>PHOTON_SMART_CLUSTER</define>

    <globalAttribute code="0xFFFD" side="either" value="1"/>

    <attribute side="server" code="0x0000" name="DeviceId" define="DEVICE_ID" type="char_string" length="36">
      <description>DeviceId</description>
      <access op="read" privilege="administer"/>
      <mandatoryConform/>
    </attribute>

    <attribute side="server" code="0x0001" name="ShouldReboot" define="SHOULD_REBOOT" type="boolean" default="0">
      <description>ShouldReboot</description>
      <mandatoryConform/>
    </attribute>

    <attribute side="server" code="0x0002" name="MqttConfig" define="MQTT_CONFIG" type="PhotonMQTTStruct" writable="true">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>MqttConfig</description>
    </attribute>

    <attribute side="server" code="0x0003" name="MqttReportEnabled" define="MQTT_REPORT_ENABLED" type="boolean" writable="true" default="1">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>MqttReportEnabled</description>
    </attribute>

    <attribute side="server" code="0x0004" name="InsightsEnabled" define="INSIGHTS_ENABLED" type="boolean" writable="true" default="1">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>InsightsEnabled</description>
    </attribute>

    <attribute side="server" code="0x0005" name="InsightsParams" define="INSIGHTS_PARAMS" type="PhotonInsightsParamsStruct" writable="true">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>InsightsParams</description>
    </attribute>

    <attribute side="server" code="0x0006" name="PublicIpv4Address" define="PUBLIC_IPV4_ADDRESS" type="int32u" default="0">
      <access op="read" privilege="administer"/>
      <mandatoryConform/>
      <description>PublicIpv4Address</description>
    </attribute>

    <attribute side="server" code="0x0007" name="PublicIpv4Enabled" define="PUBLIC_IPV4_ENABLED" type="boolean" default="1" writable="true">
      <access op="read" privilege="administer"/>
      <access op="write" privilege="administer"/>
      <mandatoryConform/>
      <description>PublicIpv4Enabled</description>
    </attribute> 


    <command source="client" code="0x00" name="Reboot" optional="true">
      <description>This command is used to reboot the device.</description>
      <arg id="0" name="RebootAfter" type="int16u" default="0" min="0" max="65535"/>
      <access op="invoke" privilege="administer"/>
      <mandatoryConform/>
    </command>

    <command source="client" code="0x01" name="FactoryReset" optional="true">
      <description>This command is used to initiate factory reset the device.</description>
      <arg id="0" name="ResetAfter" type="int16u" default="0" min="0" max="65535"/>
      <access op="invoke" privilege="administer"/>
      <mandatoryConform/>
    </command>

  </cluster>
</configurator>
